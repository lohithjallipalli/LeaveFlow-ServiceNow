        <name>Show Public Holidays</name>
        <onclick>showHolidays()</onclick>
        <order>100</order>
        <script><![CDATA[function showHolidays() {
    var start = g_form.getValue('start_date');
    var ms = start ? getDateFromFormat(start, g_user_date_format) : 0;
    var year = ms ? new Date(ms).getFullYear() : new Date().getFullYear();
    var ga = new GlideAjax('x_2236918_leavef_1.LeaveFlowAjax');
    ga.addParam('sysparm_name', 'getHolidays');
    ga.addParam('sysparm_year', year);
    ga.getXMLAnswer(function(answer) {
        var r;
        try {
            r = JSON.parse(answer);
        } catch (e) {
            r = null;
        }
        if (!r) {
            g_form.addInfoMessage('Holiday information could not be loaded.');
            return;
        }
        if (!r.ok || r.holidays.length === 0) {
            g_form.addInfoMessage(r.message || 'No holidays found.');
            return;
        }
        var lines = r.holidays.slice(0, 15).map(function(h) {
            return h.date + '  ' + h.name;
        });
        g_form.addInfoMessage('Public holidays ' + year + ':  ' + lines.join('  |  '));
    });
}]]></script>
